# Required secret. Generate a long random value for every deployed environment.
KYC_API_KEY=replace-with-a-long-random-secret

# Host path for direct local Uvicorn use. Docker Compose overrides this with the
# mounted container path /models/paddleocr/ao-id-front-v5-mobile/manifest.json.
KYC_OCR_MODEL_MANIFEST=private-models/paddleocr/ao-id-front-v5-mobile/manifest.json
KYC_OCR_DEVICE=cpu

# JSON application logging written to stdout.
KYC_LOG_LEVEL=INFO
KYC_ENVIRONMENT=development

# Optional vendor-neutral OTLP/HTTP export. Headers are secrets and must be
# supplied by the deployment environment, never committed.
KYC_OTEL_ENABLED=false
KYC_OTEL_ENDPOINT=
KYC_OTEL_HEADERS=
KYC_OTEL_TRACE_SAMPLE_RATIO=1.0
KYC_OTEL_METRIC_EXPORT_INTERVAL_SECONDS=60
KYC_OTEL_EXPORT_TIMEOUT_SECONDS=10

# API host port when using Docker Compose.
KYC_API_PORT=8000

# Service capacity and retention.
KYC_MAX_UPLOAD_BYTES=15728640
KYC_SESSION_TTL_SECONDS=1800
KYC_MAX_SESSIONS=100
KYC_JOB_WORKERS=1

# API protection controls.
KYC_RATE_LIMIT_REQUESTS=120
KYC_RATE_LIMIT_WINDOW_SECONDS=60
KYC_JOB_TIMEOUT_SECONDS=30
KYC_SESSION_CLEANUP_INTERVAL_SECONDS=60
