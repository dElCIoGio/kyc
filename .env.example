# Required secret. Generate a long random value for every deployed environment.
KYC_API_KEY=replace-with-a-long-random-secret

# Host path for direct local Uvicorn use. Docker Compose overrides this with the
# mounted container path /models/paddleocr/ao-id-front-v5-mobile/manifest.json.
KYC_OCR_MODEL_MANIFEST=private-models/paddleocr/ao-id-front-v5-mobile/manifest.json
KYC_OCR_DEVICE=cpu

# JSON application logging written to stdout.
KYC_LOG_LEVEL=INFO
KYC_ENVIRONMENT=development

# Session persistence. Direct local/test use defaults to memory. Compose
# explicitly selects PostgreSQL and builds the URL from this development-only
# password; use a secret supplied by the deployment environment in production.
KYC_SESSION_BACKEND=memory
KYC_DATABASE_URL=
KYC_DATABASE_PASSWORD=kyc-development-only

# Optional vendor-neutral OTLP/HTTP export. Headers are secrets and must be
# supplied by the deployment environment, never committed.
KYC_OTEL_ENABLED=false
KYC_OTEL_ENDPOINT=
KYC_OTEL_HEADERS=
KYC_OTEL_TRACE_SAMPLE_RATIO=1.0
KYC_OTEL_METRIC_EXPORT_INTERVAL_SECONDS=60
KYC_OTEL_EXPORT_TIMEOUT_SECONDS=10

# KYC integration sandbox host port when using Docker Compose. The API stays
# private to the Compose network; use this browser-facing port instead.
KYC_WEB_PORT=8080

# Leave false for local HTTP. Set true when the integration sandbox is served
# behind HTTPS so its in-memory-session cookie is only sent over TLS.
KYC_WEB_COOKIE_SECURE=false

# Service capacity and retention.
KYC_MAX_UPLOAD_BYTES=15728640
# Fast deterministic document-capture gate. These are initial uncalibrated
# defaults; tune only with representative calibrated capture data.
KYC_CAPTURE_MIN_SHARPNESS=25.0
KYC_CAPTURE_MIN_BRIGHTNESS=35.0
KYC_CAPTURE_MAX_BRIGHTNESS=220.0
KYC_CAPTURE_MIN_CONTRAST=12.0
# Geometry and glare are deterministic beta heuristics, not calibrated
# production policy. Assessment runs before captures are retained or OCR starts.
KYC_CAPTURE_MIN_DOCUMENT_AREA_RATIO=0.12
KYC_CAPTURE_MIN_EDGE_MARGIN_RATIO=0.015
KYC_CAPTURE_MAX_PERSPECTIVE_DISTORTION=0.30
KYC_CAPTURE_MAX_GLARE_RATIO=0.035
# Optional passive MiniFASNet liveness. These aggregation values are initial
# uncalibrated development defaults, not calibrated biometric policy.
KYC_LIVENESS_ENABLED=false
KYC_LIVENESS_MODEL_ROOT=private-models/liveness/minifasnet
KYC_LIVENESS_FRAME_COUNT=3
KYC_LIVENESS_MIN_REAL_RATIO=0.6666666667
KYC_MAX_LIVENESS_FRAME_BYTES=5242880
KYC_SESSION_TTL_SECONDS=1800
# Canonical same-origin host for hosted browser-verification links. HTTPS is
# mandatory outside localhost; the opaque browser credential appears only in a URL fragment.
KYC_PUBLIC_BASE_URL=http://127.0.0.1:8000
KYC_BROWSER_TOKEN_TTL_SECONDS=1800
# For local expiry scenarios only, override these values in .env (for example
# 120 and 180 respectively). Do not change production defaults for testing.
KYC_BROWSER_RATE_LIMIT_REQUESTS=60
KYC_MAX_SESSIONS=100
KYC_JOB_WORKERS=1
# InsightFace work is CPU-bound; keep one worker unless profiling supports more.
# Must be between 1 and KYC_MAX_SESSIONS.
KYC_FACE_MATCH_WORKERS=1

# Optional external MINFIN registry check. OCR only extracts the identifier;
# this separate step checks an applicable Angolan BI identifier against MINFIN.
KYC_NIF_VERIFICATION_ENABLED=false
KYC_NIF_TIMEOUT_SECONDS=20
KYC_NIF_STANDALONE_QUEUE_CAPACITY=8

# Session lifecycle webhooks delivered from the API to the integration sandbox.
# Both must be set together; the secret needs at least 32 characters and must
# be shared by the api and web services. The URL host must be "web" when sent
# over plain HTTP inside Docker Compose.
KYC_WEBHOOK_URL=http://web:8080/webhooks
KYC_WEBHOOK_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# API protection controls.
KYC_RATE_LIMIT_REQUESTS=120
KYC_RATE_LIMIT_WINDOW_SECONDS=60
KYC_JOB_TIMEOUT_SECONDS=30
KYC_SESSION_CLEANUP_INTERVAL_SECONDS=60
